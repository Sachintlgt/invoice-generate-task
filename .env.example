PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Optional: leave SMTP_HOST unset for local email preview mode.
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-google-app-password
# EMAIL_FROM=yourname@gmail.com
# TEST_EMAIL_TO=your-own-address@gmail.com

# Brevo alternative: SMTP_HOST=smtp-relay.brevo.com
# Use the SMTP login and SMTP key (not an API key), plus a verified EMAIL_FROM.
